# Raw dataset — never commit (PRD §3.3). The dev question sets are our own
# authored artifacts, not dataset content, so they are explicitly kept.
data/*
!data/questions_dev/
!data/questions_dev_v2/

# Trained model artifacts. Exception: models/full/ is committed so the
# "runnable system" deliverable (PRD §9.4) works from a clean checkout
# without requiring a retrain -- the weights are tiny (~49KB). Decided
# jointly, docs/bug.md issue 2's "Also needed" note.
models/*
!models/full/
# The compressed configs are tiny too, and quant8 cannot be rebuilt without
# the raw data (it calibrates on validation windows), so they are committed
# for the Phase 5 results to reproduce from a clean checkout.
!models/quant8/
!models/pruned30/
!models/pruned60/

# Bulk/raw results — keep only small summary CSVs under results/
results/raw/

# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# LaTeX build byproducts (the report's and slides' .tex and .pdf are committed)
docs/report/*.aux
docs/report/*.log
docs/report/*.out
docs/report/*.toc
docs/report/*.nav
docs/report/*.snm
docs/report/*.vrb
docs/slides/*.aux
docs/slides/*.log
docs/slides/*.out
docs/slides/*.toc
docs/slides/*.nav
docs/slides/*.snm
docs/slides/*.vrb

# Personal, local-only working notes and drafts -- not project deliverables.
# The slide draft is also kept out so it cannot clash with the committed
# deck in docs/slides/.
local_slides/
docs/member_a_walkthrough.md

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
